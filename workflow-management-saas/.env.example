# Display name of the application (used in titles, headers, emails, etc.)
VITE_APP_NAME=FlowPath

# URL of the main application (for "Sign In" and "Get Started" links)
VITE_APP_URL=https://app.flowpath.com

# URL of the backend API (for fetching pricing, etc.)
VITE_BACKEND_API_URL=http://localhost:5000/api

# Email domain used for support / sales addresses
VITE_EMAIL_DOMAIN=flowpath.com
